# Your Supabase project (public values; safe in the browser). The AI runs in
# the Supabase Edge Function "ai"; its keys are Supabase secrets, never VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "Continue with Google" shows unless this is false. Set it to false until the Google
# provider is turned on in Supabase Auth (docs/SETUP_GUIDE.md, part I).
VITE_AUTH_GOOGLE=false
