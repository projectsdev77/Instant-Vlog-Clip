# AI mode: "mock" runs the whole app with fake AI (no accounts needed).
# "live" calls the Supabase Edge Functions, which call Claude + ElevenLabs.
VITE_AI_MODE=mock

# Needed only for live mode / sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Show "Continue with Google" (enable the Google provider in Supabase Auth first).
VITE_AUTH_GOOGLE=false
